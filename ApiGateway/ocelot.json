{
  "Routes": [
    {
      "UpstreamPathTemplate": "/gateway/Orders",
      "DownstreamPathTemplate": "/api/Orders",
      "DownstreamHostAndPorts": [
        {
          "Host": "ordersmicroserviceapi",
          "Port": 8080
        }
      ],
      /* http://localhost:4000/gateway/Orders to http://ordersmicroserviceapi:8080/api/Orders */
      "UpstreamHttpMethod": [
        "Get",
        "Post",
        "Options"
      ],
      "UpstreamScheme": "http"
    }

  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:4000"
  }
}